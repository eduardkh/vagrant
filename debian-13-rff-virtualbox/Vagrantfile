Vagrant.configure("2") do |config|
  config.vm.box = "bento/debian-13"
  config.vm.box_version = "202510.26.0"
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 1024
    vb.cpus = 1
  end
  (1..3).each do |index|
    config.vm.define "router#{index}" do |router|
      router.vm.hostname = "router#{index}"
      router.vm.network "private_network", ip: "192.168.56.#{10 + index}", netmask: "255.255.255.0"
    end
  end
  config.vm.provision "shell", inline: <<-'SHELL'
  set -euo pipefail
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y curl gpg lsb-release ca-certificates traceroute

  curl --fail --silent --show-error --location --retry 3 https://deb.frrouting.org/frr/keys.gpg \
    > /usr/share/keyrings/frrouting.gpg

  echo "deb [signed-by=/usr/share/keyrings/frrouting.gpg] \
https://deb.frrouting.org/frr \
$(lsb_release -s -c) frr-10.7" \
    > /etc/apt/sources.list.d/frr.list

  apt-get update
  apt-get install -y \
    frr \
    frr-pythontools \
    iproute2 \
    tcpdump \
    jq \
    ethtool

  cat > /etc/sysctl.d/90-router.conf <<'EOF'
net.ipv4.ip_forward=1
net.ipv6.conf.all.forwarding=1
EOF
  sysctl --system
  for daemon in zebra bgpd ospfd staticd; do
    if grep -qE "^${daemon}=" /etc/frr/daemons; then
      sed -i "s/^${daemon}=.*/${daemon}=yes/" /etc/frr/daemons
    else
      printf '%s=yes\n' "$daemon" >> /etc/frr/daemons
    fi
  done
  systemctl enable frr
  systemctl restart frr
  systemctl is-active --quiet frr
  systemctl status frr --no-pager
  vtysh -c 'show version'
  for daemon in zebra bgpd ospfd staticd; do
    pgrep -x "$daemon" > /dev/null
  done
  test "$(sysctl -n net.ipv4.ip_forward)" = 1
  test "$(sysctl -n net.ipv6.conf.all.forwarding)" = 1
SHELL
end


